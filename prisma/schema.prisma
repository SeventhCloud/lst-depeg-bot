datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

model DexPair {
  id            String   @id
  chainId       String
  dexId         String
  url           String
  pairAddress   String
  labels        Json?     // store array of strings as JSON
  baseAddress   String
  baseName      String
  baseSymbol    String
  quoteAddress  String
  quoteName     String
  quoteSymbol   String
  fdv           Float?
  marketCap     Float?
  pairCreatedAt BigInt?
  imageUrl      String?
  header        String?
  openGraph     String?
  websites      Json?     // array of {label,url}
  socials       Json?     // array of {type,url}
  prices        Price[]   // relation to price table
  createdAt     DateTime  @default(now())
}

model Price {
  id          Int      @id @default(autoincrement())
  dexPairId   String
  timestamp   DateTime @default(now())
  priceNative Float
  priceUsd    Float
  volume      Json?    // {m5,h1,h6,h24,...}
  priceChange Json?    // {m5,h1,h6,h24,...}
  liquidity   Json?    // {usd,base,quote,...}
  txns        Json?    // {m5:{buys,sells},h1:{...},...}
  dexPair     DexPair     @relation(fields: [dexPairId], references: [id])
  @@index([dexPairId, timestamp])
}
